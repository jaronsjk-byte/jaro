# Perplexity Agent API. Required. Never commit the real value.
PERPLEXITY_API_KEY=

# Feature flag. Defaults to OFF when unset or empty.
AI_ANSWERS_ENABLED=false

# Percentage of users in the rollout, 0-100. Bucketed stably per contextId.
AI_ANSWERS_ROLLOUT_PCT=100

# Optional. Telemetry no-ops cleanly when these are absent.
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
