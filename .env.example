# Perplexity Agent API key. Used only by the web/ service, never by Streamlit.
PERPLEXITY_API_KEY=

# Google Gemini key for the existing Mentor chat.
# NOTE: the previous key was committed to this PUBLIC repo and must be rotated.
GOOGLE_API_KEY=

# AI answers feature flag. OFF unless explicitly enabled.
AI_ANSWERS_ENABLED=false

# URL of the deployed answers route, e.g. https://<preview>.vercel.app/api/answers
CHILLMIND_ANSWERS_URL=
